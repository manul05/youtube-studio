{
  "name": "claude-youtube-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Topic-, style- and language-agnostic YouTube production pipeline with enforced quality gates.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.cjs\"",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "help": "node tools/studio.cjs help",
    "doctor": "node tools/studio.cjs doctor",
    "next": "node tools/studio.cjs next",
    "pin:set": "node tools/studio.cjs pin:set",
    "review": "node tools/studio.cjs review",
    "new": "node tools/studio.cjs new",
    "brief:check": "node tools/studio.cjs brief:check",
    "research:check": "node tools/studio.cjs research:check",
    "outline:check": "node tools/studio.cjs outline:check",
    "script:check": "node tools/studio.cjs script:check",
    "voice:sample": "node tools/studio.cjs voice:sample",
    "voice": "node tools/studio.cjs voice",
    "voice:retake": "node tools/studio.cjs voice:retake",
    "test:live": "node --test \"tests/live/*.live.cjs\"",
    "align": "node tools/studio.cjs align",
    "voice:check": "node tools/studio.cjs voice:check"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
